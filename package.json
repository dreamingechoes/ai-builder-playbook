  "description": "How to build software with AI as a team: harnesses, workflows, software factories, measurement, and the judgment that stays human.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "npm run lint:md && npm run lint:format",
