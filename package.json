  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dreamingechoes/ai-builder-playbook/issues"
  },
  "homepage": "https://github.com/dreamingechoes/ai-builder-playbook#readme",
  "devDependencies": {
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
